{
    "model": "meta-llama/Llama-3.2-1B",
    "lora_r": 128,
    "lora_alpha": 256,
    "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "torch_dtype": "bfloat16",
    "max_length": 512,
    "target_epsilon": 8.0,
    "max_grad_norm": 1.0,
    "grad_sample_mode": "hooks",
    "max_steps": 1000,
    "batch_size": 32,
    "max_physical_batch_size": 4,
    "lr": 5e-4,
    "warmup_steps": 100,
    "save_steps": 500,
    "log_every": 10,
    "seed": 42
}
