{
    "model": "google/gemma-3-1b-it",
    "lora_r": 128,
    "lora_alpha": 256,
    "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "torch_dtype": "bfloat16",
    "max_length": 256,
    "train_data": "path_pipeline/preprocessed/mimic_train.jsonl",
    "eval_data": "path_pipeline/preprocessed/mimic_test.jsonl",
    "output_dir": "output/mimic_dp_eps10",
    "target_epsilon": 10.0,
    "max_grad_norm": 0.01,
    "grad_sample_mode": "hooks",
    "max_steps": 974,
    "batch_size": 64,
    "max_physical_batch_size": 4,
    "lr": 5e-4,
    "warmup_steps": 50,
    "eval_every": 100,
    "save_steps": 500,
    "log_every": 10,
    "seed": 42
}
